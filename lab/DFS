graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': [], 'E': [], 'F': []
}

def dfs(node, visited):
    visited.add(node)
    print(node, end=" ")
    for neighbour in graph.get(node, []):
        if neighbour not in visited:
            dfs(neighbour, visited)

start = input("Enter start node (A-F): ").upper()
dfs(start, set())