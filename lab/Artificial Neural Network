from sklearn.neural_network import MLPClassifier

X = [[0, 0], [0, 1], [1, 0], [1, 1]]
y = [0, 1, 1, 0]

model = MLPClassifier(
    hidden_layer_sizes=(4,),
    max_iter=5000,
    random_state=1
)
model.fit(X, y)

a = int(input("Enter first input (0 or 1): "))
b = int(input("Enter second input (0 or 1): "))

print("Predicted output:", model.predict([[a, b]])[0])